# Copy to .env and fill in with your Firebase Web App config values.
# (Firebase Console → Project settings → Your apps → Web app.)
# These are public client identifiers, NOT secrets. Never commit
# service-account private keys anywhere in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Realtime Database URL from Firebase Console → Realtime Database.
# Must match the instance exactly (region included if non-default).
VITE_FIREBASE_DATABASE_URL=
